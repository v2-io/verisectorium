// M0 (../m0.lp plus ../reading-write-looks.lp) in Souffle. Same rules, rule for rule.
// What had to change: every relation declared with types; constants quoted; a frontier
// item's name-with-arguments (c2_unreconciled(Q,W)) flattened to a kind and two details.
.type S <: symbol
.decl write(b:S,t:number,p:S,v:S)            .decl wrote_against(b:S,t:number,q:S,w:S)
.decl evidence(e:S,t:number,p:S,v:S,c:S,o:S) .decl reads(e:S,q:S,w:S)
.decl same(e:S,p:S,v:S,w:S)                  .decl setaside(b:S,t:number,e:S)
.decl affirm(b:S,t:number,p:S,v:S,q:S,w:S)   .decl raise(b:S,t:number,p:S,c:S)
.decl waive(b:S,t:number,k:S,d1:S,d2:S,p:S)  .decl markroot(b:S,t:number,a:S)
.decl view(r:S,t:number)                     .decl vis(r:S,b:S)
.decl slot(a:S,v:S,q:S,how:S,firm:S)         .decl pred(p:S,v:S,q:S)
.decl asks_valid(p:S) .decl result(a:S) .decl inner(a:S,x:S,y:S)
#include "story-facts.dl"

.decl time(t:number)
time(T) :- write(_,T,_,_).  time(T) :- evidence(_,T,_,_,_,_).  time(T) :- view(_,T).
.decl on(r:S,p:S,v:S,t:number)
on(R,P,V,T) :- write(B,T,P,V), vis(R,B), view(R,TR), T <= TR.
.decl over(r:S,p:S,t:number,t1:number)
over(R,P,T,T1) :- on(R,P,_,T), on(R,P,_,T2), T < T2, T2 <= T1, time(T1), view(R,TR), T1 <= TR.
.decl selat(r:S,t:number,p:S,v:S)
selat(R,T1,P,V) :- on(R,P,V,T), T <= T1, time(T1), view(R,TR), T1 <= TR, !over(R,P,T,T1).
.decl sel(r:S,p:S,v:S)
sel(R,P,V) :- selat(R,T,P,V), view(R,T).
.decl selected(r:S,p:S)
selected(R,P) :- sel(R,P,_).
.decl once(r:S,p:S,v:S)
once(R,P,V) :- on(R,P,V,_).
.decl selwrite(r:S,p:S,v:S,t:number)
selwrite(R,P,V,T) :- on(R,P,V,T), sel(R,P,V), view(R,TR), !over(R,P,T,TR).
.decl against(r:S,p:S,v:S,q:S,w:S)
against(R,P,V,Q,W) :- selwrite(R,P,V,T), write(B,T,P,V), vis(R,B), wrote_against(B,T,Q,W).

.decl known(r:S,e:S)
known(R,E) :- evidence(E,T,_,_,_,_), view(R,TR), T <= TR.
.decl aside(r:S,e:S)
aside(R,E) :- setaside(B,T,E), vis(R,B), view(R,TR), T <= TR.
.decl smv(e:S,p:S,v:S,w:S)
smv(E,P,V,W) :- same(E,P,V,W).  smv(E,P,W,V) :- smv(E,P,V,W).  smv(E,P,V,X) :- smv(E,P,V,W), smv(E,P,W,X).
.decl subj_ok(r:S,t:number,e:S)
subj_ok(R,T,E) :- evidence(E,_,P,V,_,_), selat(R,T,P,V).
subj_ok(R,T,E) :- evidence(E,_,P,V,_,_), selat(R,T,P,W), smv(E,P,V,W).
.decl read_ok(r:S,t:number,e:S,q:S)
read_ok(R,T,E,Q) :- reads(E,Q,W), selat(R,T,Q,W).
read_ok(R,T,E,Q) :- reads(E,Q,W), selat(R,T,Q,X), smv(E,Q,W,X).
.decl read_bad(r:S,t:number,e:S)
read_bad(R,T,E) :- reads(E,Q,_), known(R,E), time(T), view(R,TR), T <= TR, !read_ok(R,T,E,Q).
.decl appl_at(r:S,t:number,e:S)
appl_at(R,T,E) :- known(R,E), subj_ok(R,T,E), !read_bad(R,T,E), !aside(R,E).
.decl applies(r:S,e:S)
applies(R,E) :- appl_at(R,T,E), view(R,T).

.decl root(r:S,a:S)
root(R,A) :- markroot(B,T,A), vis(R,B), view(R,TR), T <= TR.
.decl canon(r:S,a:S)
canon(R,A) :- root(R,A), selected(R,A).
canon(R,Q) :- canon(R,A), sel(R,A,V), slot(A,V,Q,_,"firm"), selected(R,Q).

.decl viol(r:S,k:S,d1:S,d2:S,p:S)
viol(R,"c1_dangling",Q,"",P) :- canon(R,P), sel(R,P,V), pred(P,V,Q), !selected(R,Q).
.decl affirmed(r:S,p:S,v:S,q:S,w:S)
affirmed(R,P,V,Q,W) :- affirm(B,T,P,V,Q,W), vis(R,B), view(R,TR), T <= TR.
.decl reconciled(r:S,p:S,v:S,q:S,w:S)
reconciled(R,P,V,Q,W) :- against(R,P,V,Q,W).
reconciled(R,P,V,Q,W) :- affirmed(R,P,V,Q,W).
viol(R,"c2_unreconciled",Q,W,P) :- canon(R,P), sel(R,P,V), pred(P,V,Q), sel(R,Q,W), !reconciled(R,P,V,Q,W).

.decl finding(e:S,p:S,v:S,c:S,t:number)
finding(E,P,V,C,T) :- evidence(E,T,P,V,C,"fails").
viol(R,"c4_finding",E,"",P) :- canon(R,P), finding(E,P,_,_,_), applies(R,E).
.decl met(r:S,e:S)
met(R,E) :- finding(E,P,_,C,T), known(R,E), evidence(E2,T2,P,_,C,"holds"), T < T2, appl_at(R,T2,E2).
viol(R,"c4_guard",E,"",P) :- canon(R,P), finding(E,P,V,_,_), known(R,E), once(R,P,V), !sel(R,P,V), !aside(R,E), !met(R,E).

.decl checked(r:S,p:S)
checked(R,P) :- applies(R,E), evidence(E,_,P,_,"valid","holds").
viol(R,"c5_unchecked","","",P) :- canon(R,P), asks_valid(P), !checked(R,P).
.decl unread(r:S,e:S,a:S)
unread(R,E,A) :- applies(R,E), evidence(E,_,A,VA,"whole","holds"), sel(R,A,VA), slot(A,VA,Q,_,_), sel(R,Q,W), !reads(E,Q,W).
.decl whole(r:S,a:S)
whole(R,A) :- applies(R,E), evidence(E,_,A,_,"whole","holds"), !unread(R,E,A).
viol(R,"c5_not_read_whole","","",A) :- canon(R,A), result(A), !whole(R,A).

.decl together(r:S,x:S,vx:S,y:S,vy:S)
together(R,X,VX,Y,VY) :- affirmed(R,X,VX,Y,VY).
together(R,X,VX,Y,VY) :- applies(R,E), evidence(E,_,X,VX,_,"holds"), reads(E,Y,VY).
together(R,X,VX,Y,VY) :- against(R,X,VX,Y,VY).
viol(R,"c6_not_together",X,Y,A) :- canon(R,A), inner(A,X,Y), sel(R,X,VX), sel(R,Y,VY), !together(R,X,VX,Y,VY).

.decl raised(r:S,p:S,c:S,t:number)
raised(R,P,C,T) :- raise(B,T,P,C), vis(R,B), view(R,TR), T <= TR.
.decl answered(r:S,p:S,c:S,t:number)
answered(R,P,C,T) :- raised(R,P,C,T), applies(R,E), evidence(E,T2,P,_,C,_), T < T2.
viol(R,"c9_unanswered",C,"",P) :- canon(R,P), raised(R,P,C,T), !answered(R,P,C,T).

.decl waived(r:S,k:S,d1:S,d2:S,p:S)
waived(R,K,D1,D2,P) :- waive(B,T,K,D1,D2,P), vis(R,B), view(R,TR), T <= TR.
.decl owed(r:S,k:S,d1:S,d2:S,p:S)
owed(R,K,D1,D2,P) :- viol(R,K,D1,D2,P), !waived(R,K,D1,D2,P).
.decl rests(r:S,p:S,q:S)
rests(R,P,Q) :- sel(R,P,V), pred(P,V,Q).
.decl fault(r:S,p:S)
fault(R,P) :- owed(R,_,_,_,P).
fault(R,P) :- rests(R,P,Q), fault(R,Q).
fault(R,P) :- canon(R,P), rests(R,P,Q), selected(R,Q), !canon(R,Q).
owed(R,"c5_rests_on_fault",Q,"",P) :- canon(R,P), rests(R,P,Q), fault(R,Q).
.decl anything(r:S)
anything(R) :- owed(R,_,_,_,_).
.decl stationary(r:S)
stationary(R) :- view(R,_), !anything(R).
.output owed(IO=stdout)
.output stationary(IO=stdout)
