with "config/vkern_tests_config.gpr";
project Vkern_Tests is
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Vkern_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("scenarios.adb", "search.adb");
   package Compiler is
      for Default_Switches ("Ada") use Vkern_Tests_Config.Ada_Compiler_Switches;
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Vkern_Tests;
