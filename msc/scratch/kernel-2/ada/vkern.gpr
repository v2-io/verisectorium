with "config/vkern_config.gpr";
project Vkern is
   for Library_Name use "Vk";
   for Library_Version use Project'Library_Name & ".so." & Vkern_Config.Crate_Version;
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Vkern_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";
   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("VKERN_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;
   package Compiler is
      for Default_Switches ("Ada") use Vkern_Config.Ada_Compiler_Switches;
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2", "--checks-as-errors=on", "--counterexamples=on", "-j0");
   end Prove;
end Vkern;
