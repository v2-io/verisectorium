with "config/kernel_config.gpr";
project Kernel is

   for Library_Name use "Kernel";
   for Library_Version use Project'Library_Name & ".so." & Kernel_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Kernel_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("KERNEL_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Kernel_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   --  Used by `alr gnatprove` (gnatprove -P kernel.gpr). --checks-as-errors
   --  makes an unproved check fail the command (exit status 1), so "it
   --  proves" is something a script can test. Level 2 is a starting point,
   --  not a ceiling; raise it per run with e.g. `alr gnatprove --level=4`.
   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2", "--checks-as-errors=on", "--counterexamples=on", "-j0");
   end Prove;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Kernel;
