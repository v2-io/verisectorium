#!/usr/bin/env ruby
# frozen_string_literal: true
#
# defs — check, draw and read the term definitions in core/def/*.md (one term per file)
#
#   defs check     every def parses (a leading ```kdl block with one `term` node and a `status`,
#                  then the body sections); the file is named for its term (- for ⸱); no term
#                  defined twice; the body opens '# «term»' followed by the one-line def; every «…» and ‹…› resolves;
#                  relation targets are defined or promised terms; cardinalities are {m,n};
#                  the outline's `def` column agrees with which files exist
#   defs dot       Graphviz of every term with relations, edges labelled "relation {m,n}"
#   defs overview  the intros, in outline order, as one text
#   defs terms     one line per term: term, one-line definition, subtypes
#
# Resolution rules (core/model.outline.md legend, core/def/README.md):
#   «term»                 exactly one def defines it, or the outline promises it; plural per `pl`;
#                          possessive by 's or ' («veritoid's», «verisectoria'»)
#   «wording|def/term»     that def (or, if unfiled, the outline) defines the term
#   «sub⸱noun»             full name of subtype sub of noun, when sub⸱noun is not itself a term
#   ‹sub›                  declared subtype of the «noun» on the same line, or unique across the lexicon
# KDL 2.0 (gem kdl >= 2.0). Block shape:
#   term "name" pos=noun pl="-s" { subtypes "a" "b"; synonyms "x"; avoid "word" "why";
#                                  rel verb term="target" card="{m,n}" note="…" informal=#true }
#   status provisional | status decided by="steward-and-lead" on="YYYY-MM-DD"
# Body: '# «term»' then the one-line def · optional ## Intro · ## Definition or ## Definition(s) (senses or
#       elaboration, with a ### Invariants subsection) · any free ## sections ·
#       ## Discussion · ## Examples · ## Working Notes (required)

require 'kdl'

ROOT    = File.expand_path('..', __dir__)
DEF_DIR = File.join(ROOT, 'core', 'def')
OUTLINE = File.join(ROOT, 'core', 'model.outline.md')
SEP     = "⸱"

def file_for(term) = term.tr(SEP, '-')
def vals(node) = node.arguments.map(&:value)
def props(node) = node.properties.transform_values(&:value)

def parse_def(path)
  text = File.read(path)
  raise 'no leading ```kdl block' unless text =~ /\A```kdl\n(.*?)\n```\n(.*)\z/m
  kdl, body = Regexp.last_match(1), Regexp.last_match(2)
  doc = KDL.parse(kdl)
  tnodes = doc.nodes.select { |n| n.name == 'term' }
  raise "expected exactly one term node, found #{tnodes.size}" unless tnodes.size == 1
  n = tnodes.first
  t = props(n).merge('name' => vals(n).first, 'subtypes' => [], 'synonyms' => [], 'avoid' => {}, 'rels' => [])
  n.children.each do |c|
    case c.name
    when 'subtypes' then t['subtypes'] += vals(c)
    when 'synonyms' then t['synonyms'] += vals(c)
    when 'avoid'    then t['avoid'][vals(c)[0]] = vals(c)[1]
    when 'rel'
      rel, *to = vals(c)
      pr = props(c)
      to << pr.delete('term') if pr['term']
      t['rels'] << pr.merge('rel' => rel, 'to' => to)
    else raise "unknown child '#{c.name}' under term"
    end
  end
  status = doc.nodes.find { |x| x.name == 'status' }
  sections = {}
  current = nil
  body.each_line do |line|
    if line =~ /\A## (.+?)\s*\z/
      current = Regexp.last_match(1)
      sections[current] = +''
    elsif current
      sections[current] << line
    end
  end
  h1 = body[/^# «([^»]+)»\s*\n(.*)$/, 1]
  h1def = Regexp.last_match && Regexp.last_match(2).to_s.strip
  defsec = sections['Definition'] || sections['Definition(s)'] || ''
  head, inv = defsec.split(/^### Invariants\s*$/, 2)
  head ||= ""
  deflines = head.lines.map(&:rstrip).reject(&:empty?)
  invariants = (inv || head).lines.map(&:rstrip).select { |l| l.start_with?('- ') }
  { 'term' => t, 'status' => status && vals(status).first, 'sections' => sections, 'h1' => h1,
    'def' => (h1def.to_s.empty? ? deflines.find { |l| !(l.start_with?('- ') || l.start_with?('#')) } : h1def), 'invariants' => invariants, 'text' => text }
end

problems = []
outline  = File.read(OUTLINE)
outline_files = outline.scan(/\[\[def\/([^\\|\]]+)\\\|/).flatten.uniq
outline_terms, outline_subs = [], {}
outline.each_line do |l|
  next unless l =~ /\A\| *(?:provisional|promised|present) *\| *[^|]* *\| *\[\[def\/([^\\|\]]+)\\\|[^\]]*\]\] *\| *([^|]*) *\|/
  noun = $1.tr('-', SEP)
  outline_terms << noun
  outline_subs[noun] = $2.scan(/‹([^›]+)›/).flatten
end
files = Dir[File.join(DEF_DIR, '*.md')].map { |f| File.basename(f, '.md') }.reject { |f| f == 'README' }.sort

defs = {}
files.each do |f|
  defs[f] = parse_def(File.join(DEF_DIR, "#{f}.md"))
rescue StandardError => e
  problems << "#{f}: does not parse: #{e.message}"
end
order = (outline_files & defs.keys) | (defs.keys - outline_files)

terms, plurals, subtypes = {}, {}, {}          # term=>file ; plural=>term ; subtype=>[nouns]
defs.each do |f, d|
  t = d['term']['name']
  problems << "#{f}: file should be named '#{file_for(t)}' for term '#{t}'" unless file_for(t) == f
  problems << "#{f}: '#{t}' is already defined in #{terms[t]}" if terms.key?(t)
  terms[t] = f
  pl = d['term']['pl']
  plurals[pl.start_with?('-') ? t + pl[1..] : pl] = t if pl
  d['term']['subtypes'].each { |s| (subtypes[s] ||= []) << t }
end
outline_subs.each { |noun, subs| subs.each { |s| (subtypes[s] ||= []) << noun unless (subtypes[s] || []).include?(noun) } }

resolve_term = lambda do |w|
  w = w.downcase.sub(/['’]s?\z/, '')
  return w if terms.key?(w) || outline_terms.include?(w)
  return plurals[w] if plurals.key?(w)
  return w.sub(/s\z/, '') if outline_terms.include?(w.sub(/s\z/, ''))
  if w.include?(SEP)
    sub, noun = w.split(SEP, 2)
    return w if (subtypes[sub] || []).include?(noun)
  end
  nil
end

REF = /«([^»|\\]+?)(?:\\?\|def\/([^»#]+?)(?:#([^»]+))?)?»/
SUB = /‹([^›]+)›/

check_refs = lambda do |where, text|
  text = text.gsub(/`[^`]*`/, '')
  text.scan(REF) do |wording, f, t|
    if f
      t ||= f.tr('-', SEP)
      if defs.key?(f)
        problems << "#{where}: «#{wording}|def/#{f}» names #{t}, which that file does not define" unless defs[f]['term']['name'] == t
      else
        problems << "#{where}: «#{wording}|def/#{f}» names a term the outline does not promise" unless outline_terms.include?(t)
      end
    else
      problems << "#{where}: «#{wording}» resolves to no defined or promised term or subtype" unless resolve_term.call(wording)
    end
  end
  text.each_line do |line|
    line.scan(SUB) do |(sub)|
      nouns = subtypes[sub] || []
      next if nouns.size == 1
      near = line.scan(REF).map(&:first).map { |w| resolve_term.call(w) }.compact
      next if nouns.any? { |n| near.include?(n) }
      problems << (nouns.empty? ? "#{where}: ‹#{sub}› is not a declared subtype of any term" : "#{where}: ‹#{sub}› is a subtype of #{nouns.join(' and ')}; name the noun on the same line")
    end
  end
end

case ARGV[0]
when 'check'
  defs.each do |f, d|
    t = d['term']['name']
    problems << "#{f}: status is missing" unless d['status']
    problems << "#{f}: missing '# «#{t}»' heading" unless d['h1'] && d['h1'].downcase == t
    problems << "#{f}: missing section '## Definition' or '## Definition(s)'" unless d['sections'].key?('Definition') || d['sections'].key?('Definition(s)')
    problems << "#{f}: missing '## Working Notes'" unless d['sections'].key?('Working Notes')
    problems << "#{f}: no one-line def under the '# «#{t}»' heading" unless d['def']
    check_refs.call(f, d['text'])
    d['term']['rels'].each do |r|
      problems << "#{f}: relation '#{r['rel']}' has no cardinality {m,n}" unless r['card'].to_s =~ /\A\{\d+,(\d+|N)\}\z/
      next if r['informal']
      problems << "#{f}: relation '#{r['rel']}' has no target" if r['to'].empty?
      r['to'].each { |x| problems << "#{f}: relation '#{r['rel']}' points at '#{x}', which is neither defined nor promised" unless terms.key?(x) || outline_terms.include?(x) }
    end
    d['term']['subtypes'].each { |s| problems << "#{f}: subtype '#{s}' is also a term (#{terms[s]})" if terms.key?(s) }
  end
  check_refs.call('outline', outline.sub(/\A.*?\n## I\./m, ''))
  outline.each_line.with_index(1) do |line, n|
    next unless line =~ /\A\| *(provisional|promised|present|gap) *\| *([^|]+?) *\| *\[\[def\/([^\\|\]]+)\\\|/
    defcol, f = $2.strip, $3
    problems << "outline:#{n}: #{f} has def '#{defcol}' but no file core/def/#{f}.md" if defcol != '–' && !defs.key?(f)
    problems << "outline:#{n}: #{f} has a file but def column says '–'" if defcol == '–' && defs.key?(f)
  end
  (defs.keys - outline_files).each { |f| problems << "#{f}: has a file but no row in the outline" }
  if problems.empty?
    nrels = defs.values.sum { |d| d['term']['rels'].size }
    nsubs = defs.values.sum { |d| d['term']['subtypes'].size }
    puts "ok: #{defs.size} terms defined, #{nsubs} subtypes, #{nrels} relations; #{outline_files.size} terms in the outline, nothing unresolved"
  else
    puts problems
    exit 1
  end

when 'dot'
  used, edges = {}, []
  defs.each_value do |d|
    t = d['term']['name']
    d['term']['rels'].each do |r|
      next if r['informal']
      r['to'].each { |x| used[t] = used[x] = true; edges << [t, x, r['rel'], r['card']] }
    end
  end
  id = ->(t) { t.gsub(/[^a-z0-9]/, '_') }
  puts '// Generated by bin/defs dot from core/def/*.md. Do not edit; edit the definitions.'
  puts 'digraph lexicon {'
  puts '  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=1.1];'
  puts '  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor=white];'
  puts '  edge  [fontname="Helvetica", fontsize=8, color="#555555", arrowsize=0.6];'
  order.each do |f|
    t = defs[f]['term']['name']
    next unless used[t]
    subs = defs[f]['term']['subtypes']
    puts "  #{id.call(t)} [label=\"#{t}#{subs.empty? ? '' : "\\n‹#{subs.join('› ‹')}›"}\"];"
  end
  edges.each { |a, b, rel, card| puts "  #{id.call(a)} -> #{id.call(b)} [label=\"#{rel} #{card}\"#{rel == 'is-a' ? ', style=dashed' : ''}];" }
  puts '}'

when 'overview'
  order.each { |f| puts "## #{defs[f]['term']['name']}", '', (defs[f]['sections']['Intro'] || defs[f]['sections']['Definition']).to_s.strip, '' }

when 'terms'
  order.each do |f|
    subs = defs[f]['term']['subtypes']
    puts "#{defs[f]['term']['name']}\t#{defs[f]['def']}#{subs.empty? ? '' : "\t‹#{subs.join('› ‹')}›"}"
  end

else
  warn 'usage: defs check | dot | overview | terms'
  exit 2
end
