#!/usr/bin/env ruby
# frozen_string_literal: true
#
# defs — check, draw and read the definition groups in core/def/*.md
#
#   defs check     every def parses (YAML frontmatter + fixed body headings); term-group and
#                  frontmatter terms and ### «term» headings agree; no term defined twice;
#                  each group term appears as «TERM» in ## Intro; every «…» reference resolves
#                  (bare: exactly one def defines it, or the outline promises it; plural/casing
#                  per `pl`; expanded «wording|def/group#term»: that group defines or promises
#                  that term); relation targets are defined or promised terms; cardinalities
#                  are {m,n}; the outline's `def` column agrees with which files exist
#   defs dot       Graphviz of every term with relations, edges labelled "relation {m,n}"
#   defs overview  the intros, in outline order, as one text
#   defs terms     one line per term: term, group, one-line definition
#
# File shape (core/def/README.md): frontmatter {term-group, status, terms: {term: {pos, pl,
# synonyms, avoid, rels}}}; body "## Intro", "## Terms" (one "### «term»" each: first line is
# the one-line def, bullets are invariants), "## Discussion", "## Examples", "## Working Notes".

require 'yaml'

ROOT    = File.expand_path('..', __dir__)
DEF_DIR = File.join(ROOT, 'core', 'def')
OUTLINE = File.join(ROOT, 'core', 'model.outline.md')
SEP     = "⸱"
SECTIONS = ['Intro', 'Terms', 'Discussion', 'Examples', 'Working Notes'].freeze

def file_for(group) = group.tr(SEP, '-')

def parse_def(path)
  text = File.read(path)
  raise 'no frontmatter' unless text =~ /\A---\n(.*?)\n---\n(.*)\z/m
  fm, body = YAML.safe_load(Regexp.last_match(1)), Regexp.last_match(2)
  sections = {}
  current = nil
  body.each_line do |line|
    if line =~ /\A## (.+?)\s*\z/
      current = Regexp.last_match(1)
      sections[current] = +''
    elsif current
      sections[current] << line
    end
  end
  term_bodies = {}
  (sections['Terms'] || '').split(/^### /).drop(1).each do |chunk|
    head, *rest = chunk.lines
    name = head[/«([^»]+)»/, 1]
    lines = rest.map(&:rstrip).reject(&:empty?)
    term_bodies[name] = { 'def' => lines.find { |l| !l.start_with?('- ') }, 'invariants' => lines.select { |l| l.start_with?('- ') } }
  end
  { 'fm' => fm, 'sections' => sections, 'term_bodies' => term_bodies, 'text' => text }
end

problems = []
outline  = File.read(OUTLINE)
outline_groups = outline.scan(/\[\[def\/([^\\|\]]+)\\\|/).flatten.uniq
outline_terms  = outline.each_line.flat_map { |l| l =~ /\A\| *(?:provisional|promised|present) *\| *[^|]* *\| *\[\[def\/[^\]]+\]\] *\| *([^|]*) *\|/ ? $1.split('<br>').map(&:strip) : [] }.reject(&:empty?)
files = Dir[File.join(DEF_DIR, '*.md')].map { |f| File.basename(f, '.md') }.reject { |f| f == 'README' }.sort

groups = {}
files.each do |g|
  groups[g] = parse_def(File.join(DEF_DIR, "#{g}.md"))
rescue StandardError => e
  problems << "#{g}: does not parse: #{e.message}"
end
order = (outline_groups & groups.keys) | (groups.keys - outline_groups)

terms, plurals = {}, {}
groups.each do |g, d|
  listed  = Array(d['fm']['term-group'])
  fmterms = (d['fm']['terms'] || {}).keys
  headed  = d['term_bodies'].keys
  (listed - fmterms).each { |t| problems << "#{g}: '#{t}' is in term-group but has no frontmatter entry under terms" }
  (fmterms - listed).each { |t| problems << "#{g}: '#{t}' is in frontmatter terms but not in term-group" }
  (listed - headed).each { |t| problems << "#{g}: '#{t}' has no '### «#{t}»' heading under ## Terms" }
  (headed - listed).each { |t| problems << "#{g}: '### «#{t}»' heading for a term not in term-group" }
  lead = listed.first
  problems << "#{g}: file should be named '#{file_for(lead)}' (lead term, - for ⸱) unless the outline links it as #{g}" if lead && file_for(lead) != g && !outline_groups.include?(g)
  listed.each do |t|
    problems << "#{g}: '#{t}' is already defined in #{terms[t]}" if terms.key?(t)
    terms[t] = g
    pl = (d['fm']['terms'][t] || {})['pl']
    plurals[pl.start_with?('-') ? t + pl[1..] : pl] = t if pl
  end
end

def resolve_bare(w, terms, plurals)
  w = w.downcase
  return w if terms.key?(w)
  return plurals[w] if plurals.key?(w)
  nil
end

REF = /«([^»|\\]+?)(?:\\?\|def\/([^»#]+)#([^»]+))?»/

check_refs = lambda do |where, text|
  text = text.gsub(/`[^`]*`/, '')
  text.scan(REF) do |wording, g, t|
    if g
      if groups.key?(g)
        problems << "#{where}: «#{wording}|def/#{g}##{t}» names a term that group does not define" unless Array(groups[g]['fm']['term-group']).include?(t)
      else
        problems << "#{where}: «#{wording}|def/#{g}##{t}» names a term the outline does not promise" unless outline_terms.include?(t)
      end
    else
      next if resolve_bare(wording, terms, plurals)
      next if outline_terms.include?(wording.downcase) || outline_terms.include?(wording.downcase.sub(/s\z/, ''))
      problems << "#{where}: «#{wording}» resolves to no defined or promised term (expand it, or add it to the outline)"
    end
  end
end

case ARGV[0]
when 'check'
  groups.each do |g, d|
    problems << "#{g}: status is missing" unless d['fm']['status']
    (SECTIONS - d['sections'].keys).each { |s| problems << "#{g}: missing section '## #{s}'" unless %w[Discussion Examples].include?(s) }
    (d['sections'].keys - SECTIONS).each { |s| problems << "#{g}: unexpected section '## #{s}'" }
    intro = d['sections']['Intro'].to_s
    Array(d['fm']['term-group']).each do |t|
      problems << "#{g}: '#{t}' is not introduced as «#{t.upcase}» in ## Intro" unless intro.include?("«#{t.upcase}»")
      problems << "#{g}: '#{t}' has no one-line def under its heading" unless d['term_bodies'].dig(t, 'def')
    end
    check_refs.call(g, d['text'])
    (d['fm']['terms'] || {}).each do |t, m|
      Array((m || {})['rels']).each do |r|
        problems << "#{g}: '#{t}' has a relation with no name" unless r['rel']
        problems << "#{g}: '#{t}' relation #{r['rel'].inspect} parsed as non-text (quote on/off/yes/no)" unless r['rel'].is_a?(String)
        problems << "#{g}: '#{t}' relation '#{r['rel']}' has no cardinality {m,n}" unless r['card'].to_s =~ /\A\{\d+,(\d+|N)\}\z/
        next if r['informal']
        Array(r['to']).each do |target|
          problems << "#{g}: '#{t}' relation '#{r['rel']}' points at '#{target}', which is neither defined nor promised" unless terms.key?(target) || outline_terms.include?(target)
        end
      end
    end
  end
  check_refs.call('outline', outline.sub(/\A.*?\n## I\./m, ''))
  outline.each_line.with_index(1) do |line, n|
    next unless line =~ /\A\| *(provisional|promised|present|gap) *\| *([^|]+?) *\| *\[\[def\/([^\\|\]]+)\\\|/
    defcol, g = $2.strip, $3
    problems << "outline:#{n}: #{g} has def '#{defcol}' but no file core/def/#{g}.md" if defcol != '–' && !groups.key?(g)
    problems << "outline:#{n}: #{g} has a file but def column says '–'" if defcol == '–' && groups.key?(g)
  end
  (groups.keys - outline_groups).each { |g| problems << "#{g}: has a file but no row in the outline" }
  if problems.empty?
    nrels = groups.values.sum { |d| (d['fm']['terms'] || {}).values.sum { |m| Array((m || {})['rels']).size } }
    puts "ok: #{groups.size} groups, #{terms.size} terms, #{nrels} relations; #{outline_groups.size} groups in the outline, nothing unresolved"
  else
    puts problems
    exit 1
  end

when 'dot'
  palette = %w[#e6f3ee #efeaf3 #e8eef6 #fbf1e3 #f3e9e9 #eaf3f6 #f1f3e6 #f6eaf3]
  used, edges = {}, []
  groups.each_value do |d|
    (d['fm']['terms'] || {}).each do |t, m|
      Array((m || {})['rels']).each do |r|
        next if r['informal']
        Array(r['to']).each { |x| used[t] = used[x] = true; edges << [t, x, r['rel'], r['card']] }
      end
    end
  end
  id = ->(t) { t.gsub(/[^a-z0-9]/, '_') }
  puts '// Generated by bin/defs dot from core/def/*.md. Do not edit; edit the definitions.'
  puts 'digraph lexicon {'
  puts '  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=1.1];'
  puts '  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor=white];'
  puts '  edge  [fontname="Helvetica", fontsize=8, color="#555555", arrowsize=0.6];'
  order.each_with_index do |g, i|
    members = Array(groups[g]['fm']['term-group']).select { |t| used[t] }
    next if members.empty?
    puts "  subgraph cluster_#{id.call(g)} { label=\"#{g}\"; style=\"rounded,filled\"; color=\"#bbbbbb\"; fillcolor=\"#{palette[i % palette.size]}\"; fontsize=9;"
    members.each { |t| puts "    #{id.call(t)} [label=\"#{t}\"];" }
    puts '  }'
  end
  edges.each { |a, b, rel, card| puts "  #{id.call(a)} -> #{id.call(b)} [label=\"#{rel} #{card}\"#{rel == 'is-a' ? ', style=dashed' : ''}];" }
  puts '}'

when 'overview'
  order.each { |g| puts "## #{Array(groups[g]['fm']['term-group']).join(', ')}", '', groups[g]['sections']['Intro'].to_s.strip, '' }

when 'terms'
  order.each { |g| Array(groups[g]['fm']['term-group']).each { |t| puts "#{t}\t#{g}\t#{groups[g]['term_bodies'].dig(t, 'def')}" } }

else
  warn 'usage: defs check | dot | overview | terms'
  exit 2
end
