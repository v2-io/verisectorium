#!/usr/bin/env ruby
# frozen_string_literal: true
#
# defs — check, draw and read the definition groups in core/def/
#
#   defs check     every def parses; term-group and terms agree; no term defined twice;
#                  each group term appears as «TERM» in its intro; every «…» reference
#                  resolves (bare form: exactly one def defines it, plural/casing per `pl`;
#                  expanded form «wording|def/group#term»: that group defines that term);
#                  relation targets are defined terms; cardinalities are {m,n};
#                  the outline's `def` column agrees with which files exist
#   defs dot       Graphviz of every term with relations, edges labelled "relation {m,n}"
#   defs overview  the intros, in outline order, as one text
#   defs terms     one line per term: term, group, definition
#
# Conventions (core/model.outline.md, legend): terms join words with ⸱ (U+2E31);
# a def file is named for its lead term with - for ⸱; references are «term» or
# «wording|def/group#term».

require 'yaml'

ROOT    = File.expand_path('..', __dir__)
DEF_DIR = File.join(ROOT, 'core', 'def')
OUTLINE = File.join(ROOT, 'core', 'model.outline.md')
SEP     = "⸱"

def file_for(group) = group.tr(SEP, '-')

# ---- load ---------------------------------------------------------------
problems = []
outline  = File.read(OUTLINE)
outline_groups = outline.scan(/\[\[def\/([^\\|\]]+)\\\|/).flatten.uniq      # in outline order
# terms promised by the outline (terms-defined column), whether or not a def file exists yet
outline_terms = outline.each_line.flat_map { |l| l =~ /\A\| *(?:provisional|promised|present) *\| *[^|]* *\| *\[\[def\/[^\]]+\]\] *\| *([^|]*) *\|/ ? $1.split('<br>').map(&:strip) : [] }.reject(&:empty?)
files = Dir[File.join(DEF_DIR, '*.yaml')].map { |f| File.basename(f, '.yaml') }.sort

groups = {}
files.each do |g|
  begin
    groups[g] = YAML.load_file(File.join(DEF_DIR, "#{g}.yaml"))
  rescue StandardError => e
    problems << "#{g}: does not parse: #{e.message}"
  end
end
order = (outline_groups & groups.keys) | (groups.keys - outline_groups)

terms   = {}   # term  => group file
plurals = {}   # plural => term
groups.each do |g, data|
  listed  = Array(data['term-group'])
  defined = (data['terms'] || {}).keys
  (listed - defined).each { |t| problems << "#{g}: '#{t}' is in term-group but has no entry under terms" }
  (defined - listed).each { |t| problems << "#{g}: '#{t}' is defined but not in term-group" }
  lead = listed.first
  problems << "#{g}: file name should be '#{file_for(lead)}' (lead term with - for ⸱) or the group's name" if lead && file_for(lead) != g && !outline_groups.include?(g)
  defined.each do |t|
    problems << "#{g}: '#{t}' is already defined in #{terms[t]}" if terms.key?(t)
    terms[t] = g
    body = data['terms'][t]
    pl = body.is_a?(Hash) ? body['pl'] : nil
    plurals[pl.start_with?('-') ? t + pl[1..] : pl] = t if pl
  end
end

# «wording» -> term, or nil. Bare form must be unique; plural/casing via pl.
def resolve_bare(wording, terms, plurals)
  w = wording.downcase
  return w if terms.key?(w)
  return plurals[w] if plurals.key?(w)
  nil
end

def each_text(node, &blk)
  case node
  when String then blk.call(node)
  when Array  then node.each { |n| each_text(n, &blk) }
  when Hash   then node.each_value { |n| each_text(n, &blk) }
  end
end

REF = /«([^»|\\]+?)(?:\\?\|def\/([^»#]+)#([^»]+))?»/

def check_refs(where, text, terms, plurals, groups, outline_terms, problems)
  text = text.gsub(/`[^`]*`/, '')   # code spans are examples of the notation, not uses of it
  text.scan(REF) do |wording, g, t|
    if g
      if groups.key?(g)
        problems << "#{where}: «#{wording}|def/#{g}##{t}» names a term that group does not define" unless Array(groups[g]['term-group']).include?(t)
      else
        problems << "#{where}: «#{wording}|def/#{g}##{t}» names a term the outline does not promise" unless outline_terms.include?(t)
      end
    else
      next if resolve_bare(wording, terms, plurals)
      next if outline_terms.include?(wording.downcase) || outline_terms.include?(wording.downcase.sub(/s\z/, ''))   # promised, not yet filed
      problems << "#{where}: «#{wording}» resolves to no defined or promised term (expand it, or add it to the outline)"
    end
  end
end

case ARGV[0]
when 'check'
  groups.each do |g, data|
    problems << "#{g}: status is missing" unless data['status']
    intro = data['intro'].to_s
    problems << "#{g}: intro is missing" if intro.strip.empty?
    Array(data['term-group']).each do |t|
      problems << "#{g}: '#{t}' is not introduced as «#{t.upcase}» in the intro" unless intro.include?("«#{t.upcase}»")
    end
    each_text(data) { |text| check_refs(g, text, terms, plurals, groups, outline_terms, problems) }
    (data['terms'] || {}).each do |t, body|
      problems << "#{g}: '#{t}' has no def" unless body.is_a?(Hash) && body['def']
      Array(body.is_a?(Hash) ? body['rels'] : nil).each do |r|
        problems << "#{g}: '#{t}' has a relation with no name" unless r['rel']
        problems << "#{g}: '#{t}' relation #{r['rel'].inspect} parsed as non-text (quote words like on, off, yes, no)" unless r['rel'].is_a?(String)
        problems << "#{g}: '#{t}' relation '#{r['rel']}' has no cardinality {m,n}" unless r['card'].to_s =~ /\A\{\d+,(\d+|N)\}\z/
        next if r['informal']
        Array(r['to']).each do |target|
          problems << "#{g}: '#{t}' relation '#{r['rel']}' points at '#{target}', which is neither defined nor promised by the outline" unless terms.key?(target) || outline_terms.include?(target)
        end
      end
    end
  end
  # outline agreement
  check_refs('outline', outline.sub(/\A.*?\n## I\./m, ''), terms, plurals, groups, outline_terms, problems)   # legend excluded
  outline.each_line.with_index(1) do |line, n|
    next unless line =~ /\A\| *(provisional|promised|present|gap) *\| *([^|]+?) *\| *(\[\[def\/([^\\|\]]+)\\\||[^|]+?) *\|/
    mark, defcol, _, g = $1, $2.strip, $3, $4
    next unless g
    has = groups.key?(g)
    problems << "outline:#{n}: #{g} has def '#{defcol}' but no file core/def/#{g}.yaml" if defcol != '–' && !has
    problems << "outline:#{n}: #{g} has a file but def column says '–'" if defcol == '–' && has
  end
  (groups.keys - outline_groups).each { |g| problems << "#{g}: has a file but no row in the outline" }

  if problems.empty?
    nrels = groups.values.sum { |d| (d['terms'] || {}).values.sum { |b| Array(b['rels']).size } }
    puts "ok: #{groups.size} groups, #{terms.size} terms, #{nrels} relations; #{outline_groups.size} groups in the outline, nothing unresolved"
  else
    puts problems
    exit 1
  end

when 'dot'
  palette = %w[#e6f3ee #efeaf3 #e8eef6 #fbf1e3 #f3e9e9 #eaf3f6 #f1f3e6 #f6eaf3]
  used = {}
  edges = []
  groups.each_value do |data|
    (data['terms'] || {}).each do |t, body|
      Array(body['rels']).each do |r|
        next if r['informal']
        Array(r['to']).each { |target| used[t] = used[target] = true; edges << [t, target, r['rel'], r['card']] }
      end
    end
  end
  id = ->(t) { t.gsub(/[^a-z0-9]/, '_') }
  puts '// Generated by bin/defs dot from core/def/*.yaml. Do not edit; edit the definitions.'
  puts 'digraph lexicon {'
  puts '  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=1.1];'
  puts '  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor=white];'
  puts '  edge  [fontname="Helvetica", fontsize=8, color="#555555", arrowsize=0.6];'
  order.each_with_index do |g, i|
    members = (groups[g]['terms'] || {}).keys.select { |t| used[t] }
    next if members.empty?
    puts "  subgraph cluster_#{id.call(g)} { label=\"#{g}\"; style=\"rounded,filled\"; color=\"#bbbbbb\"; fillcolor=\"#{palette[i % palette.size]}\"; fontsize=9;"
    members.each { |t| puts "    #{id.call(t)} [label=\"#{t}\"];" }
    puts '  }'
  end
  edges.each { |from, to, rel, card| puts "  #{id.call(from)} -> #{id.call(to)} [label=\"#{rel} #{card}\"#{rel == 'is-a' ? ', style=dashed' : ''}];" }
  puts '}'

when 'overview'
  order.each do |g|
    puts "## #{Array(groups[g]['term-group']).join(', ')}", '', groups[g]['intro'].to_s.strip, ''
  end

when 'terms'
  order.each { |g| (groups[g]['terms'] || {}).each { |t, body| puts "#{t}\t#{g}\t#{body['def']}" } }

else
  warn 'usage: defs check | dot | overview | terms'
  exit 2
end
